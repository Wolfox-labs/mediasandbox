# MediaSandbox 环境变量样例
#
# 用法：复制为 .env 并填入真实值，然后
#   pnpm start          # 用 .env 启动服务
# 注意 .env 已被 .gitignore 忽略，不要把真实密钥提交进仓库。

# ── 服务 ──────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1

# ── 决策层 ────────────────────────────────────────────────────────────
# 三选一：
#   demo（默认）= 演示决策层，按目标关键词选工具，无需任何模型即可跑通且演示自洽
#   stub        = 固定回答的桩，与输入无关，用于测试
#   rizzo       = 真实 rizzo-flow（需先部署，见 RIZZO_BASE_URL）
MEDIASANDBOX_DECISION=demo
# 接真实 rizzo-flow 时把上面改成 rizzo，并确保服务已启动
RIZZO_BASE_URL=http://127.0.0.1:8017
RIZZO_MODEL=rizzo-latest

# ── 生成层（内容生成，可选）──────────────────────────────────────────
# 不配置则生成式工具不可用，只能走确定性路线（产物为占位文本）
#
# 两种接法二选一：
#   A. 任意 OpenAI 兼容端点
#      LLM_BASE_URL=https://api.example.com/v1
#   B. 预置厂商：openai / deepseek / moonshot / dashscope / local
#      LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
LLM_PROVIDER=deepseek
LLM_MODEL=

# ── 沙盒 ──────────────────────────────────────────────────────────────
# local = 路径级隔离（开发用）；docker = 容器级隔离（跑不可信代码用）
SANDBOX_PROVIDER=local
# 保留多少个已结束运行的沙盒（产物下载依赖它）。0 = 不保留
SANDBOX_RETENTION=20
