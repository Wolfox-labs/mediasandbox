{
  "name": "@mediasandbox/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist/**/*.test.js\"",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@mediasandbox/orchestrator": "workspace:*",
    "@mediasandbox/sandbox": "workspace:*",
    "express": "^5.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.2",
    "@types/ws": "^8.18.1",
    "dockerode": "^5.0.1",
    "typescript": "^5.9.3"
  }
}
